generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("CONTROL_PLANE_DATABASE_URL")
  directUrl = env("CONTROL_PLANE_DIRECT_URL")
}

enum TenantStatus {
  PROVISIONING
  ACTIVE
  SUSPENDED
  FAILED
}

model Tenant {
  id          String       @id @default(cuid())
  name        String
  subdomain   String       @unique
  status      TenantStatus @default(PROVISIONING)

  // Envelope-encrypted (AES-256-GCM) connection strings for this tenant's own Neon database.
  // Decrypted only inside control-plane/lib/crypto.ts — never logged, never returned to a client.
  databaseUrlEnc String @db.Text
  directUrlEnc   String @db.Text
  neonProjectId  String

  // Denormalized branding cache (source of truth is the tenant's own TenantBranding row).
  // Kept here so edge/middleware tenant resolution and messaging never need to open the
  // tenant's own database just to know its display name/logo/color/timezone.
  brandName    String?
  logoUrl      String?
  primaryColor String?
  timezone     String  @default("Asia/Manila")

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  provisionedAt     DateTime?
  createdBySuperAdminId String?

  provisioningLogs ProvisioningLog[]
  featureFlags     TenantFeatureFlag[]
  subscription     Subscription?
  securityIncidents SecurityIncidentTenant[]

  @@index([status])
}

model SuperAdmin {
  id          String   @id @default(cuid())
  email       String   @unique
  password    String
  totpSecret  String?
  totpEnabled Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model ProvisioningLog {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  step      String
  status    String
  detail    String?  @db.Text
  createdAt DateTime @default(now())

  @@index([tenantId])
}

// Fixed registry of known flags — created by a superadmin, not tenants themselves.
model FeatureFlag {
  key         String   @id
  description String?
  createdAt   DateTime @default(now())

  tenants TenantFeatureFlag[]
}

// A row's mere existence means the flag is ON for that tenant — no `enabled` boolean,
// so a new FeatureFlag needs zero backfill and defaults off for every existing tenant.
// Toggling on = create the row, toggling off = delete it.
model TenantFeatureFlag {
  id        String      @id @default(cuid())
  tenantId  String
  tenant    Tenant      @relation(fields: [tenantId], references: [id])
  flagKey   String
  flag      FeatureFlag @relation(fields: [flagKey], references: [key])
  createdAt DateTime    @default(now())

  @@unique([tenantId, flagKey])
  @@index([tenantId])
}

// ── Platform billing (Phase 9) ────────────────────────────────────────────────
// Scaffolding only -- built without a live Xendit account to test against (see
// control-plane/lib/xendit-api.ts and app/api/webhooks/xendit/route.ts). The data
// model, promo codes, and webhook receiver work standalone; the parts that actually
// call Xendit or act on its webhooks are inert until XENDIT_SECRET_KEY and
// XENDIT_WEBHOOK_TOKEN are configured.

enum SubscriptionStatus {
  PENDING_FIRST_CHARGE
  ACTIVE
  PAST_DUE
  SUSPENDED_PENDING
  CANCELLED
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  SEMI_ANNUAL
  ANNUAL
}

enum PromoCodeType {
  PERCENT
  FIXED
}

enum InvoiceStatus {
  PENDING
  PAID
  FAILED
  VOID
}

// 1:1 with Tenant. Money fields are Int centavos (never Float) -- these are real
// platform revenue records, unlike the gym-side Float fields used for member billing.
model Subscription {
  id               String             @id @default(cuid())
  tenantId         String             @unique
  tenant           Tenant             @relation(fields: [tenantId], references: [id])
  baseRateCentavos Int
  billingCycle     BillingCycle       @default(MONTHLY)
  status           SubscriptionStatus @default(PENDING_FIRST_CHARGE)

  xenditCustomerId String?
  xenditPlanId     String?

  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?

  // Snapshotted at the time the promo was applied -- editing/deactivating the
  // PromoCode template later never retroactively changes an already-discounted tenant.
  promoCodeId          String?
  promoCode            PromoCode?     @relation(fields: [promoCodeId], references: [id])
  discountSnapshotType PromoCodeType?
  discountSnapshotValue Int?

  // Optional per-tenant grace window on top of Xendit's own dunning retries, off by
  // default. pendingSuspensionAt is set instead of suspending immediately when > 0.
  suspensionGraceHours Int       @default(0)
  pendingSuspensionAt  DateTime?

  // A rate or promo change requires migrating to a *new* Xendit plan (amounts are
  // effectively immutable there), not an in-place edit -- this makes a failure
  // mid-migration visible/retryable instead of silently stuck.
  migrationState String?

  invoices Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Invoice {
  id             String       @id @default(cuid())
  invoiceNumber  String       @unique
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])

  baseCentavos     Int
  discountCentavos Int @default(0)
  vatCentavos      Int @default(0)
  totalCentavos    Int

  status            InvoiceStatus @default(PENDING)
  xenditCycleId     String?
  rawWebhookPayload Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subscriptionId])
}

// Atomic counter for sequential invoice numbers -- same pattern as the tenant-side
// MemberNumberSequence.
model InvoiceNumberSequence {
  id      String @id @default("singleton")
  lastVal Int    @default(0)
}

model PromoCode {
  id              String        @id @default(cuid())
  code            String        @unique
  type            PromoCodeType
  value           Int // percent (0-100) if type=PERCENT, or centavos if type=FIXED
  isActive        Boolean       @default(true)
  maxRedemptions  Int?
  redemptionCount Int           @default(0)
  validFrom       DateTime?
  validUntil      DateTime?
  createdAt       DateTime      @default(now())

  subscriptions Subscription[]
}

// Idempotency + audit trail for inbound Xendit webhooks (Xendit retries delivery up to
// 6 times on any non-2xx response, so double-processing must be a non-issue). Xendit's
// webhook payload has no single dedicated delivery-id field -- xenditEventId is
// constructed as `${event}:${data.id}` in the webhook route; revisit once real payloads
// can be inspected against a sandbox account.
model XenditWebhookEvent {
  id            String   @id @default(cuid())
  xenditEventId String   @unique
  eventType     String
  payload       Json
  processedAt   DateTime @default(now())
}

// Small KV table, mirrors the tenant-side SystemSetting pattern. vatRegistered is a
// switch the owner flips once actually BIR-registered -- VAT is never computed or shown
// on invoices while it's false.
model PlatformSetting {
  key   String @id
  value String
}

// ── Marketing site (Phase 10) ─────────────────────────────────────────────────

// Contact-form submissions from the public flowforcerm.com marketing page. Always
// persisted regardless of whether the notification email succeeds -- a real business
// lead should never be lost just because RESEND_API_KEY isn't configured yet.
model ContactInquiry {
  id        String   @id @default(cuid())
  name      String
  gymName   String
  email     String
  phone     String?
  message   String   @db.Text
  createdAt DateTime @default(now())
}

// ── Legal / privacy / electronic agreements (Phase 1) ─────────────────────────
// FlowForceRM's OWN platform-level legal documents (Terms of Service, Privacy
// Policy, DPA, Acceptable Use Policy) as the SaaS vendor -- distinct from each
// tenant's own gym-facing waiver/rules/privacy text (tenant-side SystemSetting,
// see lib/legal-documents.ts), which this does not touch. Content lives here
// because one ToS/Privacy Policy/DPA/AUP applies platform-wide, not per tenant.
// Acceptance RECORDS live in each tenant's own database instead (see
// LegalAgreementAcceptance in the tenant schema) since they FK to that tenant's
// own User.id, which this database has no relation to.
//
// DEVELOPMENT PLACEHOLDER CONTENT ONLY. Every document seeded for dev/testing
// must carry a visible "DRAFT / PLACEHOLDER -- REQUIRES REVIEW AND APPROVAL BY
// QUALIFIED PHILIPPINE LEGAL/PRIVACY COUNSEL BEFORE COMMERCIAL USE" banner.
// Nothing in this schema or its surrounding code implies legal compliance.

enum LegalDocumentType {
  TERMS_OF_SERVICE
  PRIVACY_POLICY
  DATA_PROCESSING_AGREEMENT
  ACCEPTABLE_USE_POLICY
}

enum LegalDocumentStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
  ARCHIVED
}

model LegalDocument {
  id     String            @id @default(cuid())
  type   LegalDocumentType
  title  String
  version String
  content String           @db.Text // Markdown, sanitized on render, never trusted as raw HTML

  // SHA-256 hex of `content`, computed server-side at publish time. An integrity
  // aid for showing exactly what content an acceptance record refers to -- not by
  // itself a claim of legal validity.
  contentHash String?

  status           LegalDocumentStatus @default(DRAFT)
  summaryOfChanges String?             @db.Text
  effectiveDate    DateTime?
  publishedAt      DateTime?
  supersededAt     DateTime?

  createdBySuperAdminId String?
  createdAt             DateTime @default(now())
  updatedAt              DateTime @updatedAt

  // "At most one PUBLISHED row per type" is enforced in the publish API route
  // (a transaction that supersedes the old published row and publishes the new
  // one together), not here -- Prisma has no partial-unique-index support for this.
  @@unique([type, version])
  @@index([type, status])
}

// Control-plane has no general audit log yet (ProvisioningLog is provisioning-
// specific) -- this covers superadmin actions on legal documents (and future
// control-plane admin actions), mirroring the tenant-side AuditLog/logAudit()
// shape so the two systems stay conceptually consistent.
model SuperAdminAuditLog {
  id           String   @id @default(cuid())
  superAdminId String
  action       String
  entityType   String
  entityId     String?
  description  String
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([superAdminId])
  @@index([createdAt])
}

// ── Phase 2: subprocessor registry ──────────────────────────────────────────
// Platform-wide, superadmin-managed list of third-party services that process
// customer/personal data on FlowForceRM's behalf. Surfaced read-only to
// tenants (any authenticated role) via GET /api/subprocessors. Seeded from the
// factual inventory compiled in LEGAL_REVIEW_REQUIRED.md.

enum SubprocessorStatus {
  ACTIVE
  INACTIVE
}

model Subprocessor {
  id             String             @id @default(cuid())
  name           String
  service        String // what they provide, e.g. "Hosting", "Email delivery"
  purpose        String             @db.Text
  dataCategories String             @db.Text
  location       String?
  status         SubprocessorStatus @default(ACTIVE)
  effectiveDate  DateTime?
  referenceUrl   String? // the provider's own privacy/security page
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
}

// ── Phase 2: security/privacy incident management ──────────────────────────
// Superadmin-only -- never exposed to gym users (spec: "Do not expose incident
// details to ordinary gym users"). notificationStatus is free text; no NPC
// breach-notification deadline is assumed or hard-coded anywhere in this system.

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  CONTAINED
  INVESTIGATING
  RESOLVED
}

model SecurityIncident {
  id                      String           @id @default(cuid())
  detectedAt              DateTime
  occurredAt              DateTime?
  affectedSystems         String           @db.Text
  dataCategories          String           @db.Text
  affectedRecordsEstimate Int?
  severity                IncidentSeverity
  status                  IncidentStatus   @default(OPEN)
  remediation             String?          @db.Text
  notificationStatus      String?
  resolvedAt              DateTime?
  responsibleSuperAdminId String
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  affectedTenants SecurityIncidentTenant[]
}

model SecurityIncidentTenant {
  id         String           @id @default(cuid())
  incidentId String
  incident   SecurityIncident @relation(fields: [incidentId], references: [id])
  tenantId   String
  tenant     Tenant           @relation(fields: [tenantId], references: [id])

  @@unique([incidentId, tenantId])
}
