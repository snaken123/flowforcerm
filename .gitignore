# dependencies
node_modules/

# environment variables — NEVER commit these
.env
.env.local
.env.production
.env*.local

# Next.js build output
.next/
out/

# next-pwa build output -- regenerated fresh on every `next build`; committing it
# means a browser's already-installed service worker can go stale against routes
# added after the last time someone happened to commit this file
public/sw.js
public/workbox-*.js

# Prisma generated client
node_modules/.prisma/

# uploads folder (user photos stored locally)
public/uploads/

# misc
.DS_Store
*.pem
npm-debug.log*

.vercel
.env*

# Test reports
test-reports/

# personal Claude Code local overrides
.claude/settings.local.json

# stray reserved-name artifact from source repo
nul
.neon
